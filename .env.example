# ====================================================================
# Universal ACP Client — Environment Variables (Categorized Edition)
# ====================================================================
# Copy this file to .env and fill in your API keys.
#
#   cp .env.example .env
#   # Edit .env with your keys
#   npm install
#   npm run hello -- <agent-id>
#
# Common commands:
#   npm run hello -- gemini         # Google Gemini CLI
#   npm run hello -- claude         # Claude Code
#   npm run hello -- codex          # OpenAI Codex
#   npm run hello -- codebuddy      # Tencent CodeBuddy
#   npm run hello -- goose          # Goose (Block/Square)
#   npm run hello -- opencode       # OpenCode
#   npm run hello -- kimi           # Moonshot Kimi
#   npm run hello -- kiro           # Kiro AI
#   npm run hello -- aider          # Aider
#   npm run hello -- copilot        # GitHub Copilot
#   npm run hello -- --list         # List all agents
#   npm run hello -- --check        # Check which agents are ready
#
# ====================================================================

# ====================================================================
# 1. API KEYS & AUTHENTICATION (Core — fill in for agents you use)
# ====================================================================
# These keys are shared across multiple tools. Set once, use everywhere.

# ── OpenAI ──
# Used by: Aider, Codex, Goose, Kimi(config), CodeBuddy(via provider)
# Get key: https://platform.openai.com/
# OPENAI_API_KEY=sk-...

# ── Anthropic ──
# Used by: Aider, Claude Code, Goose, Kimi(config), CodeBuddy(via provider)
# Get key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# ── Google Gemini ──
# Used by: Aider, Gemini CLI, Goose, Kimi(config)
# Get key: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY=${GEMINI_API_KEY}   # Alias, same value

# ── DeepSeek ──
# Used by: Aider
# Get key: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-...

# ── OpenRouter ──
# Used by: Aider, Goose
# Get key: https://openrouter.ai/
# OPENROUTER_API_KEY=sk-or-v1-...

# ── xAI / Grok ──
# Used by: Aider
# Get key: https://console.x.ai/
# XAI_API_KEY=xai-...

# ── Moonshot / Kimi ──
# Used by: Kimi Code CLI (via config.toml env sub-table)
# Get key: https://platform.moonshot.cn/
# KIMI_API_KEY=sk-...

# ── Tencent CodeBuddy ──
# Used by: CodeBuddy Code
# Get key: https://cloud.tencent.com/
# CODEBUDDY_API_KEY=sk-...
# CODEBUDDY_AUTH_TOKEN=your-auth-token

# ── GitHub Copilot ──
# Used by: Copilot CLI, Aider
# Create a fine-grained PAT with 'Copilot Requests' permissions:
# https://github.com/settings/tokens
# COPILOT_GITHUB_TOKEN=ghp_...        # Highest precedence
# GH_TOKEN=ghp_...                    # Second precedence (also used by gh CLI)
# GITHUB_TOKEN=ghp_...                # Third precedence (also used by gh CLI)

# ── AWS (for Bedrock) ──
# Used by: Claude Code (CLAUDE_CODE_USE_BEDROCK=1), Aider, Goose
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# ── Databricks ──
# Used by: Goose
# DATABRICKS_HOST=https://your-instance.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...

# ── Snowflake ──
# Used by: Goose
# SNOWFLAKE_HOST=your-account.snowflakecomputing.com
# SNOWFLAKE_TOKEN=...

# ====================================================================
# 2. BASE URLs & ENDPOINTS (Custom API gateways / proxies)
# ====================================================================

# ── Anthropic / Claude ──
# Used by: Claude Code, Goose, Kimi(config)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Claude Code: Enterprise proxy auth token ──
# Set this instead of ANTHROPIC_API_KEY when using a custom gateway
# ANTHROPIC_AUTH_TOKEN=bearer-token-from-proxy

# ── OpenAI ──
# Used by: Aider, Codex, Goose, Kimi(config), CodeBuddy(via provider)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Google Gemini ──
# Used by: Gemini CLI
# GOOGLE_GEMINI_BASE_URL=https://my-proxy.com
# GOOGLE_VERTEX_BASE_URL=https://my-vertex-proxy.com
# GOOGLE_GENAI_API_VERSION=v1

# ── Kimi / Moonshot ──
# Used by: Kimi Code CLI (in config.toml env sub-table)
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# ── CodeBuddy ──
# CODEBUDDY_BASE_URL=https://tencent.sso.copilot.tencent.com
# CODEBUDDY_INTERNET_ENVIRONMENT=public   # public | internal | ioa
# CODEBUDDY_CUSTOM_HEADERS="X-Custom: Value"

# ── OpenRouter ──
# Used by: Goose, Aider
# OPENROUTER_HOST=https://openrouter.ai

# ── Ollama (local models) ──
# Used by: Goose
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_TIMEOUT=30

# ====================================================================
# 3. MODEL SELECTION (Override default models per tool)
# ====================================================================

# ── Claude Code ──
# CLAUDE_MODEL=claude-sonnet-5                    # or ANTHROPIC_MODEL (alias)
# ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4-5     # Background/summary model
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5
# ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-8
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5

# ── CodeBuddy ──
# CODEBUDDY_MODEL=                                 # Override default agent model
# CODEBUDDY_SMALL_FAST_MODEL=                      # Background task model
# CODEBUDDY_BIG_SLOW_MODEL=                        # Complex reasoning model
# CODEBUDDY_CODE_SUBAGENT_MODEL=                   # Sub-agent model
# MAX_THINKING_TOKENS=10000                        # Extended thinking budget

# ── Copilot ──
# COPILOT_MODEL=gpt-5.2                            # or claude-sonnet-4.5

# ── Goose ──
# GOOSE_PROVIDER=anthropic                         # anthropic | openai | google | databricks | ...
# GOOSE_MODEL=claude-sonnet-4-20250514
# GOOSE_MODE=smart-approve                         # auto | approve | smart-approve | chat

# ── Aider (AIDER_ prefix for any CLI flag) ──
# AIDER_MODEL=claude-sonnet-4-6
# AIDER_WEAK_MODEL=claude-haiku-4-5
# AIDER_EDITOR_MODEL=claude-sonnet-4-6
# AIDER_REASONING_EFFORT=medium
# AIDER_THINKING_TOKENS=10000

# ====================================================================
# 4. PROXY & NETWORK (Corporate / VPN environments)
# ====================================================================

# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1,*.internal.company.com

# ====================================================================
# 5. TELEMETRY & PRIVACY (Opt-out of data collection)
# ====================================================================

# ── Claude Code ──
# DISABLE_TELEMETRY=1                              # Disable Anthropic telemetry
# DISABLE_ERROR_REPORTING=1                        # Disable Sentry error reports
# DISABLE_COST_WARNINGS=1                          # Hide cost warning banner
# DISABLE_AUTOUPDATER=1                            # Disable auto-update (CI/CD must!)

# ── Goose ──
# GOOSE_TELEMETRY_OFF=1                            # Disable anonymous usage data
# GOOSE_TELEMETRY_ENABLED=false                    # Alternative form

# ── Gemini CLI ──
# GEMINI_TELEMETRY_ENABLED=false
# GEMINI_TELEMETRY_TRACES_ENABLED=false
# GEMINI_TELEMETRY_TARGET=local                    # local | gcp
# GEMINI_TELEMETRY_OTLP_ENDPOINT=

# ── CodeBuddy ──
# CODEBUDDY_DISABLE_AUTO_MEMORY=1                  # Disable auto memory

# ── Aider ──
# AIDER_ANALYTICS_DISABLE=1                        # Disable analytics

# ====================================================================
# 6. BASH / SHELL CONFIGURATION (Command execution behavior)
# ====================================================================

# ── CodeBuddy ──
# BASH_DEFAULT_TIMEOUT_MS=120000                   # Default: 2 minutes
# BASH_MAX_OUTPUT_LENGTH=30000                     # Default: 30K chars
# BASH_MAX_TIMEOUT_MS=600000                       # Default: 10 minutes
# CODEBUDDY_CODE_SHELL=bash                        # bash | zsh | sh | powershell
# CODEBUDDY_CODE_SHELL_PREFIX=                     # Prefix for all shell commands
# CODEBUDDY_ENV_FILE=                              # Auto-source before each shell cmd
# CODEBUDDY_CODE_GIT_BASH_PATH=                    # Git Bash path (Windows)
# CODEBUDDY_POWERSHELL_PATH=                       # PowerShell path (Windows)
# CODEBUDDY_USE_POWERSHELL_TOOL=1                  # Enable PowerShell tool
# CODEBUDDY_DISABLE_SHELL_SNAPSHOT=1               # Disable shell env snapshots

# ── Claude Code ──
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=4096               # Cap response length

# ====================================================================
# 7. MCP (Model Context Protocol)
# ====================================================================

# MCP_TIMEOUT=30000                                # Server startup timeout (ms)
# MCP_TOOL_TIMEOUT=120000                          # Tool execution timeout (ms)
# MAX_MCP_OUTPUT_TOKENS=50000                      # Combined token budget per turn

# ── CodeBuddy MCP ──
# CODEBUDDY_WAIT_FOR_MCP_SERVERS_ENABLED=0         # Disable WaitForMcpServers
# CODEBUDDY_DEFERRED_TOOLS_MCP_READY_WAIT_MS=2500  # Wait before rendering
# CODEBUDDY_DEFER_TOOL_LOADING=0                   # Disable deferred loading
# CODEBUDDY_DISABLE_MCP_LARGE_OUTPUT_FILES=1       # Skip persisting large outputs

# ====================================================================
# 8. UI & DISPLAY (Terminal appearance and behavior)
# ====================================================================

# ── Global ──
# NO_COLOR=1                                       # Disable all color output
# VERBOSE=0

# ── Kiro ──
# KIRO_LOG_LEVEL=debug                             # debug | info | warn | error
# KIRO_LOG_NO_COLOR=1                              # Disable log colors
# KIRO_ASCII_MODE=1                                # Force ASCII (no Unicode)
# KIRO_CHAT_UI=tui                                 # tui | classic
# KIRO_NO_HYPERLINKS=1                             # Disable clickable links
# KIRO_NO_PROGRESS=1                               # Disable progress indicator
# KIRO_NO_SYNCHRONIZED=1                           # Disable synchronized output

# ── CodeBuddy ──
# CODEBUDDY_CODE_DISABLE_TERMINAL_TITLE=1          # Disable terminal title updates

# ── OpenCode ──
# OPENCODE_DISABLE_TERMINAL_TITLE=1
# OPENCODE_DISABLE_MOUSE=1                         # Disable TUI mouse capture

# ── Copilot ──
# PLAIN_DIFF=1                                     # Disable rich diff rendering
# COLORFGBG=0;15                                   # Dark=0;15, Light=15;0

# ── Aider ──
# AIDER_DARK_MODE=1
# AIDER_LIGHT_MODE=0
# AIDER_PRETTY=1
# AIDER_STREAM=1
# AIDER_SHOW_DIFFS=1
# AIDER_VIM=0

# ====================================================================
# 9. FEATURE TOGGLES (Enable/disable specific capabilities)
# ====================================================================

# ── CodeBuddy ──
# CODEBUDDY_DISABLE_HOT_RELOAD=1
# CODEBUDDY_SKIP_BUILTIN_MARKETPLACE=1
# CODEBUDDY_IMAGE_GEN_ENABLED=1
# CODEBUDDY_IMAGE_EDIT_ENABLED=1
# CODEBUDDY_COMPUTER_USE_ENABLED=1                 # macOS desktop control (Accessibility required)
# CODEBUDDY_DISABLE_CRON=1
# CODEBUDDY_DISABLE_BACKGROUND_TASKS=1
# CODEBUDDY_DISABLE_FORK_SUBAGENT=1
# CODEBUDDY_MEMORY_ENABLED=1
# CODEBUDDY_TYPED_MEMORY_ENABLED=1
# CODEBUDDY_TEAM_MEMORY_ENABLED=1
# CODEBUDDY_AUTO_UPDATE_THIRD_PARTY_MARKETPLACES=1

# ── OpenCode ──
# OPENCODE_DISABLE_AUTOUPDATE=1
# OPENCODE_DISABLE_PRUNE=1
# OPENCODE_DISABLE_DEFAULT_PLUGINS=1
# OPENCODE_DISABLE_LSP_DOWNLOAD=1
# OPENCODE_ENABLE_EXPERIMENTAL_MODELS=1
# OPENCODE_DISABLE_AUTOCOMPACT=1
# OPENCODE_DISABLE_CLAUDE_CODE=1
# OPENCODE_DISABLE_CLAUDE_CODE_PROMPT=1
# OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1
# OPENCODE_DISABLE_MODELS_FETCH=1
# OPENCODE_ENABLE_EXA=1                            # Exa web search

# ── Copilot ──
# COPILOT_ALLOW_ALL=true                           # Auto-allow all permissions
# COPILOT_AUTO_UPDATE=false
# USE_BUILTIN_RIPGREP=false                        # Use system ripgrep
# COPILOT_CLI_ENABLED_FEATURE_FLAGS=FLAG1,FLAG2

# ── Aider ──
# AIDER_AUTO_COMMITS=1
# AIDER_AUTO_LINT=1
# AIDER_AUTO_TEST=0
# AIDER_GIT=1
# AIDER_CACHE_PROMPTS=1
# AIDER_WATCH_FILES=0
# AIDER_ARCHITECT=0

# ====================================================================
# 10. TOOL-SPECIFIC CONFIGURATION (Directories, paths, overrides)
# ====================================================================

# ── Goose ──
# GOOSE_PATH_ROOT=./.goose                         # Local config directory
# GOOSE_DISABLE_KEYRING=1                          # Use file-based secret storage
# GOOSE_WORKING_DIR=/path/to/project
# GOOSE_CLI_MIN_PRIORITY=0.0                       # 0.0=all, 0.8=high only
# GOOSE_ALLOWLIST=https://allowed-extensions.json
# SECURITY_PROMPT_ENABLED=true
# SECURITY_PROMPT_THRESHOLD=0.8

# ── OpenCode ──
# OPENCODE_CONFIG=./.opencode.json                 # Config file override
# OPENCODE_CONFIG_DIR=~/.config/opencode           # Config directory
# OPENCODE_TUI_CONFIG=
# OPENCODE_CONFIG_CONTENT={"key":"value"}          # Inline JSON config
# OPENCODE_GIT_BASH_PATH=C:\\Program Files\\Git\\bin\\bash.exe
# OPENCODE_MODELS_URL=https://custom.models.config
# OPENCODE_SERVER_PASSWORD=secret                  # Basic auth for serve/web
# OPENCODE_SERVER_USERNAME=opencode

# ── Kiro ──
# KIRO_HOME=./.kiro                                # Override ~/.kiro
# KIRO_ACP_RECORD_PATH=./kiro-acp.log              # ACP wire traffic log
# KIRO_CLI_TOOL_SEARCH_MATCHING_THRESHOLD=1.5

# ── Aider ──
# AIDER_CONFIG_DIR=                                # Custom config directory
# AIDER_MAP_TOKENS=1024                            # Repo map token budget
# AIDER_MAX_CHAT_HISTORY_TOKENS=
# AIDER_CACHE_KEEPALIVE_PINGS=12
# AIDER_LINT_CMD="eslint --fix"                    # Per-language lint commands
# AIDER_TEST_CMD="npm test"

# ── Copilot ──
# COPILOT_HOME=~/.copilot                          # Config/state directory
# COPILOT_SKILLS_DIRS=/path/to/skills1,/path/to/skills2
# COPILOT_CUSTOM_INSTRUCTIONS_DIRS=/path/to/inst1
# COPILOT_EDITOR=vim                               # After $VISUAL/$EDITOR

# ── CodeBuddy ──
# CODEBUDDY_CONFIG_DIR=                            # Custom config/data dir
# CODEBUDDY_CODE_DEBUG_LOGS_DIR=
# CODEBUDDY_SANDBOX_IMAGE=node:20-alpine
# CODEBUDDY_PLUGIN_DIRS=/path/to/plugin1:/path/to/plugin2
# CODEBUDDY_USER_ID=                               # For team memory
# CODEBUDDY_CODE_MAX_TURNS=500                     # Main agent max turns
# CODEBUDDY_CODE_SUBAGENT_MAX_TURNS=500            # Sub-agent max turns

# ── Gemini CLI ──
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# ── Kimi (Google Cloud for Vertex AI) ──
# GOOGLE_CLOUD_PROJECT=                            # Used in config.toml env sub-table
# GOOGLE_CLOUD_LOCATION=                           # Used in config.toml env sub-table

# ── Claude Code: Cloud routing ──
# CLAUDE_CODE_USE_BEDROCK=1                        # Route via AWS Bedrock
# CLAUDE_CODE_USE_VERTEX=1                         # Route via Google Vertex AI
# CLOUD_ML_REGION=us-central1                      # For Vertex AI
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id  # For Vertex AI

# ====================================================================
# 11. OVERRIDE COMMANDS (Advanced — custom binary paths)
# ====================================================================

# Adapters already prefer a locally installed entry point and only fall back to
# `npx` when they cannot resolve one (package not installed, unusual layout).
# Overriding is therefore only needed to point at a custom binary, or to force a
# specific launcher:
#
# GEMINI_CLI_COMMAND=gemini
# GEMINI_CLI_ARGS=--acp
#
# CLAUDE_CLI_COMMAND=npx
# CLAUDE_CLI_ARGS=-y @agentclientprotocol/claude-agent-acp acp
#
# CODEBUDDY_CLI_COMMAND=npx
# CODEBUDDY_CLI_ARGS=-y --package @tencent-ai/codebuddy-code codebuddy --acp
#
# GOOSE_CLI_COMMAND=goose
# GOOSE_CLI_ARGS=acp
#
# AIDER_CLI_COMMAND=aider
# AIDER_CLI_ARGS=--acp
#
# CODEX_CLI_COMMAND=codex
# CODEX_CLI_ARGS=--acp
